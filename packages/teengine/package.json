{
  "name": "teengine",
  "version": "0.4.0",
  "description": "2D TypeScript game engine — WebGPU, ECS, optional Rapier.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dioveath/teengine-js",
    "directory": "packages/teengine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teengine/core": "workspace:*",
    "@teengine/physics": "workspace:*",
    "@teengine/renderer-webgpu": "workspace:*",
    "@teengine/renderer-canvas2d": "workspace:*"
  },
  "keywords": ["game-engine", "webgpu", "2d", "typescript", "rapier"]
}
